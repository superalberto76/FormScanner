# FormScanner configuration for docker-compose.yml.
# Copy this file to .env and, before the first start, change at least:
#   JWT_SECRET, POSTGRES_PASSWORD (also inside DATABASE_URL),
#   INITIAL_ADMIN_EMAIL and INITIAL_ADMIN_PASSWORD.
# Full reference of the variables: docs/specification/architecture.md

# --- Application ---
APP_NAME=FormScanner
# With "production" the backend refuses to start if the database schema is
# missing. The migrations run automatically at every start of the backend.
APP_ENV=production
TZ=UTC

# --- Ports published on the host ---
FRONTEND_PORT=8080
BACKEND_PORT=8000

# --- Browser access ---
# Both values are seen by the browser. To open FormScanner from another
# machine, replace localhost with the host name or address of this machine
# in both, then rebuild: docker compose up -d --build
# VITE_API_BASE_URL is built into the frontend: changing it needs a rebuild.
VITE_API_BASE_URL=http://localhost:8000/api/v1
# Comma-separated origins allowed to call the API (where the frontend is opened).
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# --- Authentication ---
# A long random secret, e.g. the output of: openssl rand -hex 32
JWT_SECRET=change_me_with_a_long_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- Initial administrator ---
# Created at the first start if no user has this email. At every start the
# account is kept enabled and with the ADMIN role.
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=ChangeMe!
# Set to true for one start to reset the administrator's password to
# INITIAL_ADMIN_PASSWORD, then set it back to false.
# FORCE_RESET_ADMIN_PASSWORD=false

# --- Database ---
POSTGRES_DB=formscanner
POSTGRES_USER=formscanner
POSTGRES_PASSWORD=change_me_db_password
# Must repeat user, password and database name above. "db" is the database
# service of docker-compose.yml.
DATABASE_URL=postgresql+psycopg://formscanner:change_me_db_password@db:5432/formscanner

# --- OCR ---
# Language of the OCR that reads free-text areas: Tesseract language codes
# (eng, ita, deu, chi_sim, ...), combinable with '+' (e.g. ita+eng).
# The Docker image ships eng and ita; the backend does not start if a
# configured language is not installed.
OCR_LANGUAGE=eng

# --- Uploads ---
# Maximum size of one uploaded PDF of scanned sheets, in bytes (50 MiB).
MAX_SUBMISSION_PDF_BYTES=52428800

# --- Backend inside its container (normally left as they are) ---
BACKEND_HOST=0.0.0.0
# Storage paths inside the container; ./data/storage on the host.
STORAGE_PATH=/data/storage
ORIGINAL_UPLOADS_DIR=/data/storage/originals
RENDERED_PAGES_DIR=/data/storage/rendered_pages
SUBMISSION_ORIGINALS_DIR=/data/storage/submission_originals
SUBMISSION_PAGES_DIR=/data/storage/submission_pages
